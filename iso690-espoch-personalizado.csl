<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="es-ES">
  <info>
    <title>ISO 690 ESPOCH Simple</title>
    <id>http://www.zotero.org/styles/iso-690-espoch-simple</id>
    <link href="http://www.zotero.org/styles/iso-690-espoch-simple" rel="self"/>
    <author>
      <name>OpenAI</name>
    </author>
    <category citation-format="author-date"/>
    <updated>2026-04-03T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/"/>
  </info>

  <locale xml:lang="es-ES">
    <terms>
      <term name="in">En</term>
      <term name="online">en línea</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " initialize-with=". ">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title" suffix="."/>
  </macro>

  <macro name="journal">
    <group>
      <text term="in" suffix=" "/>
      <text variable="container-title" font-style="italic"/>
      <text value=" [en línea]."/>
    </group>
  </macro>

  <macro name="volume-issue">
    <group delimiter=", ">
      <group>
        <text value="vol. "/>
        <text variable="volume"/>
      </group>
      <group>
        <text value="n.º "/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <group>
          <text value="pp. "/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="issn">
    <choose>
      <if variable="ISSN">
        <group>
          <text value="ISSN "/>
          <text variable="ISSN"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <group>
          <text value="DOI: "/>
          <text variable="DOI"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="url">
    <choose>
      <if variable="URL">
        <group>
          <text value="Disponible en: "/>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="publisher-place">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="book-date">
    <date variable="issued">
      <date-part name="day" suffix=" de "/>
      <date-part name="month" form="long" suffix=" de "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="isbn">
    <choose>
      <if variable="ISBN">
        <group>
          <text value="ISBN "/>
          <text variable="ISBN"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="accessed">
        <group>
          <text value="[Consulta: "/>
          <date variable="accessed">
            <date-part name="day" suffix=" "/>
            <date-part name="month" form="long" suffix=" "/>
            <date-part name="year"/>
          </date>
          <text value="]."/>
        </group>
      </if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short"/>
          <substitute>
            <text variable="title" form="short"/>
          </substitute>
        </names>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>

        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="journal"/>
            <group delimiter=", ">
              <text macro="issued-year"/>
              <text macro="volume-issue"/>
              <text macro="pages"/>
            </group>
            <text macro="issn"/>
            <text macro="doi"/>
            <text macro="url"/>
          </group>
        </if>

        <else-if type="book">
          <group delimiter=" ">
            <text macro="author"/>
            <text variable="title" font-style="italic" suffix="."/>
            <text macro="publisher-place" suffix=","/>
            <text macro="book-date" suffix="."/>
            <text macro="isbn"/>
          </group>
        </else-if>

        <else-if type="thesis">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="title"/>
            <text value="[en línea]."/>
            <text variable="publisher-place" suffix=","/>
            <text macro="issued-year"/>
            <text macro="access"/>
            <text macro="url"/>
          </group>
        </else-if>

        <else-if type="webpage post-weblog report" match="any">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="title"/>
            <text value="[en línea]."/>
            <text macro="issued-year"/>
            <text macro="access"/>
            <text macro="url"/>
          </group>
        </else-if>

        <else>
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="issued-year"/>
            <text macro="url"/>
          </group>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>